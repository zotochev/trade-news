# Copy to .env and fill in. Never commit .env.

# --- database (optional; default comes from config.yaml: sqlite:///data/trade_news.db)
# DATABASE_URL=sqlite:///data/trade_news.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/trade_news

# --- stage 1: collectors
# SEC EDGAR: no key, but the User-Agent must identify you: "Name email@domain"
SEC_USER_AGENT=trade-news zotochev@gmail.com
# Finnhub: free key at https://finnhub.io/register (dashboard shows it after sign-up)
FINNHUB_API_KEY=
# Marketaux: free key at https://www.marketaux.com/register (100 requests/day)
MARKETAUX_API_KEY=
# Not wired yet: CryptoPanic, Financial Modeling Prep (economic calendar), FRED
CRYPTOPANIC_TOKEN=
FMP_API_KEY=
FRED_API_KEY=

# --- stage 3: LLM annotation
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Telegram
# A SEPARATE bot from @BotFather (/newbot): only one app may poll getUpdates per token.
TELEGRAM_BOT_TOKEN=
# Owner's chat id: always receives the mailing and sees subscribe/unsubscribe notices.
TELEGRAM_CHAT_ID=

# --- admin web page
# Listens on 127.0.0.1:ADMIN_PORT only; nginx (HTTPS + auth_basic) proxies it: deploy/trade-news-admin.conf, how-to: deploy/HTTPS.md
ADMIN_PORT=10000

# --- misc
# LOG_LEVEL=INFO
# TRADE_NEWS_CONFIG=config.yaml
